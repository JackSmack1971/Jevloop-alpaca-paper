# Copy to .env. Never commit .env.

# Alpaca PAPER Trading API credentials. The packaged runtime rejects the live base URL.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# IEX is the conservative default for US-equity market data on basic plans.
ALPACA_EQUITY_FEED=iex

# Optional Jev provider. Vercel AI Gateway currently exposes model typesafe-ai/jev.
AI_GATEWAY_API_KEY=

# Optional direct TypeSafe route. The API exposes GET /v1/models; pin a model
# explicitly so a direct-provider model change is never silent.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=

DEFAULT_SYMBOL=BTC/USD
